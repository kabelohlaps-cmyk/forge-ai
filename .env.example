# --- Auth (multi-user) ---
# Generate: openssl rand -hex 32 -- signs the API's own access tokens
JWT_SECRET=replace_with_openssl_rand_hex_32
# Generate: openssl rand -base64 32 -- for NextAuth's own session encryption
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com -> OAuth client ID, type "Web application")
# Same GOOGLE_CLIENT_ID must be set for both the web app and the API (the API
# verifies that Google tokens were issued for this exact client).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Sign In (developer.apple.com -> Certificates, Identifiers & Profiles)
# Requires a paid Apple Developer account. APPLE_CLIENT_ID is your Services ID
# (not your app's bundle ID). APPLE_PRIVATE_KEY is the .p8 file contents.
APPLE_CLIENT_ID=com.yourcompany.forgeai.web
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Encryption ---
# Generate: openssl rand -base64 32 -- there is no default, the app refuses to start without this
ENCRYPTION_MASTER_KEY=replace_with_openssl_rand_base64_32

# --- CORS ---
WEB_ORIGIN=http://localhost:3000

# --- PayPal ---
PAYPAL_CLIENT_ID=AXxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=ELxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_WEBHOOK_ID=WH-xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_PLAN_CREATOR=P-XXXXXXXXXXXXXXXX
PAYPAL_PLAN_ARCHITECT=P-XXXXXXXXXXXXXXXX
PAYPAL_PLAN_STUDIO=P-XXXXXXXXXXXXXXXX

# --- Database & AI ---
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
GEMINI_API_KEY=your_actual_api_key_here
# Optional -- defaults to gemini-2.5-flash if unset
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AXxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
